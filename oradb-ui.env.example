# /etc/oradb-ui.env  –  Rechte 600, gehört root
ORADB_UI_USER=admin
ORADB_UI_PASSWORD=bitte-aendern
ORADB_UI_LISTEN=0.0.0.0
ORADB_UI_PORT=8088

ORADB_BASE=/srv/oradb
ORADB_IMAGE=oracle/database:19.30.0-ee
# Hostname in den angezeigten JDBC-URLs (Standard: FQDN des Hosts)
#ORADB_DB_HOST=db05-alma10.intern.example
ORADB_DEV_PORT_START=15211
ORADB_DEV_PORT_END=15299
# Wie lange auf "DATABASE IS READY TO USE" gewartet wird (Sekunden)
ORADB_READY_TIMEOUT=900
# Eigenes SQL, das beim Release-Erstellen vor "shutdown immediate" läuft
# (z. B. memory_target bei AMM, Passwörter zurücksetzen, Anonymisierung)
#ORADB_RELEASE_SQL_FILE=/etc/oradb-ui-release.sql
