# /etc/zeitkapsel.env – Rechte 600, gehört root
#
# Rolle: all (Controller + Agent, erster Host), controller, agent (weitere DB-Hosts)
ZK_ROLE=all
ZK_LISTEN=0.0.0.0
ZK_PORT=8088

# --- Agent (Rollen all und agent) -------------------------------------------------
# Geheimes Token, mit dem der Controller den Agenten anspricht: app.py gen-token
ZK_AGENT_TOKEN=bitte-mit-app.py-gen-token-erzeugen
ZK_BASE=/srv/oradb
ZK_IMAGE=oracle/database:19.30.0-ee
# Hostname in den angezeigten JDBC-URLs (Standard: FQDN des Hosts)
#ZK_DB_HOST=db05-alma10.intern.example
ZK_DEV_PORT_START=15211
ZK_DEV_PORT_END=15299
# Wartezeit auf "DATABASE IS READY TO USE" beim Start bzw. bei der Neuanlage (Sekunden)
ZK_READY_TIMEOUT=900
ZK_CREATE_TIMEOUT=5400
# SQL, das beim Release-Erstellen vor "shutdown immediate" läuft (Speicher, Anonymisierung)
#ZK_RELEASE_SQL_FILE=/etc/zeitkapsel-release.sql
# SSH-Schlüssel für den Import von anderen Servern (wird bei Bedarf erzeugt)
ZK_SSH_KEY=/root/.ssh/zeitkapsel_ed25519
# Neue DB-Subvolumes ohne Copy-on-Write anlegen (chattr +C). Achtung: dann keine Kompression
# und keine Prüfsummen. Standard 0, damit compress/compress-force des Dateisystems greift.
ZK_NOCOW=0
# Auslastung: Messabstand (Sekunden), Aufbewahrung (Stunden), grober Bedarf einer Entwickler-DB (MB)
ZK_METRICS_INTERVAL=30
ZK_METRICS_HOURS=24
ZK_DEV_DB_MB=2048
# Wie viele Vorgänge (mit Protokoll) in meta/jobs/ aufbewahrt werden
ZK_JOBS_KEEP=500
# Wie lange ermittelter Platz pro Subvolume zwischengespeichert wird (Sekunden)
ZK_USAGE_MAX_AGE=900
# Data-Pump-Verzeichnis der Master-DBs (wird nur gemountet, wenn vorhanden)
ZK_MASTER_DUMPS=/srv/oradumps

# --- Controller (Rollen all und controller) ----------------------------------------
ZK_DATA=/var/lib/zeitkapsel/zeitkapsel.db
# Hinter einem Reverse Proxy mit TLS auf 1 setzen
ZK_COOKIE_SECURE=0
ZK_SESSION_HOURS=12
